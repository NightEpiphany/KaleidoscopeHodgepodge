{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "kaleidoscope_hodgepodge:custom_feast",
    "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "kaleidoscope_hodgepodge:soup_base",
      "on_false": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [{"when": ["gui"], "model": {"type": "minecraft:model", "model": "kaleidoscope_hodgepodge:item/porcelain_soup_bowl_empty_without_soup"}}],
        "fallback": {"type": "minecraft:model", "model": "kaleidoscope_hodgepodge:block/porcelain_soup_bowl_without_soup"}
      },
      "on_true": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [{"when": ["gui"], "model": {"type": "minecraft:model", "model": "kaleidoscope_hodgepodge:item/porcelain_soup_bowl_empty_with_soup"}}],
        "fallback": {"type": "minecraft:model", "model": "kaleidoscope_hodgepodge:block/porcelain_soup_bowl_with_soup"}
      }
    },
    "on_true": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "kaleidoscope_hodgepodge:soup_base",
      "on_false": {
        "type": "minecraft:composite",
        "models": [
          {"type": "minecraft:model", "model": "kaleidoscope_hodgepodge:block/porcelain_soup_bowl_without_soup"},
          {"type": "minecraft:special", "base": "kaleidoscope_hodgepodge:block/porcelain_soup_bowl_without_soup", "model": {"type": "kaleidoscope_hodgepodge:custom_feast"}}
        ]
      },
      "on_true": {
        "type": "minecraft:composite",
        "models": [
          {"type": "minecraft:model", "model": "kaleidoscope_hodgepodge:block/porcelain_soup_bowl_with_soup"},
          {"type": "minecraft:special", "base": "kaleidoscope_hodgepodge:block/porcelain_soup_bowl_with_soup", "model": {"type": "kaleidoscope_hodgepodge:custom_feast"}}
        ]
      }
    }
  }
}
